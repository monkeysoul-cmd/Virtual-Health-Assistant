{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/components/*"],
      "@/features/*": ["src/components/features/*"],
      "@/layout/*": ["src/components/layout/*"],
      "@/common/*": ["src/components/common/*"],
      "@/ui/*": ["src/components/ui/*"],
      "@/services/*": ["src/services/*"],
      "@/schemas/*": ["src/schemas/*"],
      "@/config/*": ["src/config/*"],
      "@/data/*": ["src/data/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/utils/*": ["src/utils/*"],
      "@/lib/*": ["src/lib/*"]
    }
  },
  "include": ["src/**/*"]
}
